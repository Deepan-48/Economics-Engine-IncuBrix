# IncuBrix Economics Engine — Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=IncuBrix Economics Engine
APP_VERSION=1.0.0
DEBUG=true
FEATURE_FLAG_ECONOMICS_ENGINE=true

# Database — PostgreSQL
DATABASE_URL=postgresql://incubrix:incubrix_pass@localhost:5432/incubrix_economics

# SQLite fallback for local dev without Postgres
# DATABASE_URL=sqlite:///./economics_engine.db

# API
API_PREFIX=/api/video-economics
PORT=8000

# Policy defaults
DEFAULT_ASYNC_SAVINGS_THRESHOLD=0.15
DEFAULT_NEAR_BUDGET_THRESHOLD=0.85
DEFAULT_UNCERTAINTY_LOW_MULTIPLIER=0.9
DEFAULT_UNCERTAINTY_HIGH_MULTIPLIER=1.2
